{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ScriptHost", "ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler module resolution strategy is crucial for Vite assets */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Setup type checks to look directly into Vite's native environment bindings */
    "types": ["vite/client"]
  }
}